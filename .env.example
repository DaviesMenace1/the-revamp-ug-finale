# Analytics and consent-gated marketing integrations
# Use a GA4 Measurement ID (G-...) only when loading Google Analytics directly.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Use a Google Tag Manager web container ID (GTM-...). This is separate from the GA4 ID.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile (auth pages)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames returned by Turnstile
TURNSTILE_ALLOWED_HOSTNAMES=therevampug.com,www.therevampug.com

# Better Stack server-side error logging
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_URL=https://in.logs.betterstack.com

# Upstash Redis (rate limiting and cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OneSignal Web Push
NEXT_PUBLIC_ONESIGNAL_APP_ID=800e8e9a-66b7-487c-a452-3665ff2e32f9
ONESIGNAL_REST_API_KEY=

# Flutterwave payments (sandbox by default; use live only after full testing)
FLUTTERWAVE_MODE=sandbox
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_CURRENCY=UGX
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Consultation reminder delivery
BREVO_API_KEY=
SENDER_EMAIL=info@therevampug.com
SENDER_NAME=The Revamp UG
NEXT_PUBLIC_SITE_URL=https://www.therevampug.com
CRON_SECRET=

# Cloudflare R2 (required for generated PDFs and private GLB/GLTF assets)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Database connection
DATABASE_URL=

# Keep all secret values in Vercel Environment Variables, never in Git.
